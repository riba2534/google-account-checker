{
  "name": "google-account-checker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build && wrangler dev",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply agy-checker-db --local",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "hono": "^4.13.22",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.168.0"
  }
}
